# Copie ce fichier en .env.local et remplis avec Supabase > Project Settings > API Keys.
# Clé : la "Publishable key" (sb_publishable_...) ou, sur les anciens projets, la clé "anon" (eyJ...).
# Ne mets JAMAIS la "Secret key" / service_role ici.
# Sans ces variables, l'app fonctionne en mode local (collection stockée dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
